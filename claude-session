#!/bin/bash

# Claude Session Manager - Multi-session Discord bot controller
# Manages multiple Claude Code instances across different repositories

set -e

CONFIG_DIR="/root/.claude-sessions"
BOT_SCRIPT="/root/discord-bridge.py"
PYTHON_BIN="/root/bot-env/bin/python3"
TEMPLATE_DIR="/root/config-files"

# Colors for output
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Helper function to parse YAML (simple key:value parser)
parse_yaml() {
    local file=$1
    local key=$2
    grep "^${key}:" "$file" | sed "s/^${key}:[[:space:]]*//" | tr -d '"' | tr -d "'"
}

# Get all configured repos
get_repos() {
    if [ ! -d "$CONFIG_DIR" ]; then
        return
    fi
    for config in "$CONFIG_DIR"/*.yaml; do
        if [ -f "$config" ]; then
            basename "$config" .yaml
        fi
    done
}

# Check if bot is running for a repo
get_bot_pid() {
    local repo=$1
    local config_path="$CONFIG_DIR/${repo}.yaml"
    pgrep -f "discord-bridge.py --config $config_path" | head -1
}

# Check if tmux session exists
tmux_session_exists() {
    local session=$1
    tmux has-session -t "$session" 2>/dev/null
}

# Command: list
cmd_list() {
    echo -e "${BLUE}=== Claude Code Sessions ===${NC}"
    echo ""

    local has_configs=false
    if [ -d "$CONFIG_DIR" ]; then
        for f in "$CONFIG_DIR"/*.yaml; do
            if [ -f "$f" ]; then
                has_configs=true
                break
            fi
        done
    fi

    if [ "$has_configs" = "false" ]; then
        echo -e "${YELLOW}No sessions configured yet.${NC}"
        echo "Run 'claude-session add' to create your first session."
        return
    fi

    while IFS= read -r repo; do
        local config="$CONFIG_DIR/${repo}.yaml"
        local repo_name=$(parse_yaml "$config" "repo_name")
        local repo_path=$(parse_yaml "$config" "repo_path")
        local tmux_session=$(parse_yaml "$config" "tmux_session")
        local enabled=$(parse_yaml "$config" "enabled")
        local channel_id=$(parse_yaml "$config" "discord_channel_id")

        echo -e "${GREEN}● ${repo}${NC}"
        echo "  Repo: $repo_path"
        echo "  Tmux: $tmux_session"
        echo "  Channel ID: $channel_id"
        echo "  Enabled: $enabled"

        local pid=$(get_bot_pid "$repo")
        if [ -n "$pid" ]; then
            echo -e "  Bot: ${GREEN}Running${NC} (PID $pid)"
        else
            echo -e "  Bot: ${RED}Stopped${NC}"
        fi

        if tmux_session_exists "$tmux_session"; then
            echo -e "  Tmux: ${GREEN}Active${NC}"
        else
            echo -e "  Tmux: ${YELLOW}Not found${NC}"
        fi

        echo ""
    done < <(get_repos)
}

# Command: status
cmd_status() {
    echo -e "${BLUE}=== Quick Status ===${NC}"
    echo ""

    local total=0
    local running=0

    while IFS= read -r repo; do
        total=$((total + 1))
        local pid=$(get_bot_pid "$repo")
        if [ -n "$pid" ]; then
            running=$((running + 1))
            echo -e "${GREEN}✓${NC} $repo (PID $pid)"
        else
            echo -e "${RED}✗${NC} $repo"
        fi
    done < <(get_repos)

    echo ""
    echo "Running: $running/$total"
}

# Command: start
cmd_start() {
    local repo=$1
    if [ -z "$repo" ]; then
        echo -e "${RED}Error: Repository name required${NC}"
        echo "Usage: claude-session start <repo-name>"
        exit 1
    fi

    local config="$CONFIG_DIR/${repo}.yaml"
    if [ ! -f "$config" ]; then
        echo -e "${RED}Error: Configuration not found: $config${NC}"
        echo "Run 'claude-session add' to create configuration."
        exit 1
    fi

    local pid=$(get_bot_pid "$repo")
    if [ -n "$pid" ]; then
        echo -e "${YELLOW}Bot already running (PID $pid)${NC}"
        return
    fi

    local repo_name=$(parse_yaml "$config" "repo_name")
    local repo_path=$(parse_yaml "$config" "repo_path")
    local tmux_session=$(parse_yaml "$config" "tmux_session")
    local enabled=$(parse_yaml "$config" "enabled")

    if [ "$enabled" != "true" ]; then
        echo -e "${YELLOW}Warning: Session is disabled in config${NC}"
    fi

    echo -e "${BLUE}Starting session: $repo_name${NC}"

    if ! tmux_session_exists "$tmux_session"; then
        echo "Creating tmux session: $tmux_session"
        tmux new-session -d -s "$tmux_session" -c "$repo_path"
        tmux set-environment -t "$tmux_session" CLAUDE_SESSION_NAME "$repo_name"
    else
        echo "Tmux session already exists: $tmux_session"
    fi

    echo "Starting Discord bot..."
    cd "$repo_path"
    nohup $PYTHON_BIN "$BOT_SCRIPT" --config "$config" > "/tmp/discord-bridge-${repo}.log" 2>&1 &
    local new_pid=$!

    sleep 1

    if ps -p $new_pid > /dev/null 2>&1; then
        echo -e "${GREEN}✓ Bot started successfully (PID $new_pid)${NC}"
        echo "Log: /tmp/discord-bridge-${repo}.log"
    else
        echo -e "${RED}✗ Bot failed to start${NC}"
        echo "Check log: /tmp/discord-bridge-${repo}.log"
        exit 1
    fi
}

# Command: stop
cmd_stop() {
    local repo=$1
    if [ -z "$repo" ]; then
        echo -e "${RED}Error: Repository name required${NC}"
        echo "Usage: claude-session stop <repo-name>"
        exit 1
    fi

    local pid=$(get_bot_pid "$repo")
    if [ -z "$pid" ]; then
        echo -e "${YELLOW}Bot not running${NC}"
        return
    fi

    echo "Stopping bot (PID $pid)..."
    kill "$pid"
    sleep 1

    if ps -p $pid > /dev/null 2>&1; then
        echo -e "${YELLOW}Bot didn't stop gracefully, forcing...${NC}"
        kill -9 "$pid"
        sleep 1
    fi

    if ps -p $pid > /dev/null 2>&1; then
        echo -e "${RED}✗ Failed to stop bot${NC}"
        exit 1
    else
        echo -e "${GREEN}✓ Bot stopped${NC}"
    fi
}

# Command: restart
cmd_restart() {
    local repo=$1
    if [ -z "$repo" ]; then
        echo -e "${RED}Error: Repository name required${NC}"
        echo "Usage: claude-session restart <repo-name>"
        exit 1
    fi

    echo -e "${BLUE}Restarting session: $repo${NC}"
    cmd_stop "$repo"
    sleep 1
    cmd_start "$repo"
}

# Command: logs
cmd_logs() {
    local repo=$1
    if [ -z "$repo" ]; then
        echo -e "${RED}Error: Repository name required${NC}"
        echo "Usage: claude-session logs <repo-name>"
        exit 1
    fi

    local log_file="/tmp/discord-bridge-${repo}.log"
    if [ ! -f "$log_file" ]; then
        echo -e "${YELLOW}Log file not found: $log_file${NC}"
        exit 1
    fi

    echo -e "${BLUE}=== Logs for $repo ===${NC}"
    tail -f "$log_file"
}

# Command: init-repo
cmd_init_repo() {
    local repo=$1
    if [ -z "$repo" ]; then
        echo -e "${RED}Error: Repository name required${NC}"
        echo "Usage: claude-session init-repo <repo-name>"
        exit 1
    fi

    local config="$CONFIG_DIR/${repo}.yaml"
    if [ ! -f "$config" ]; then
        echo -e "${RED}Error: Configuration not found: $config${NC}"
        exit 1
    fi

    local repo_name=$(parse_yaml "$config" "repo_name")
    local repo_path=$(parse_yaml "$config" "repo_path")

    echo -e "${BLUE}Initializing Claude Code in: $repo_path${NC}"

    local claude_dir="$repo_path/.claude"
    mkdir -p "$claude_dir"

    local template="$TEMPLATE_DIR/settings.local.template.json"
    if [ -f "$template" ]; then
        echo "Copying settings template..."
        local settings="$claude_dir/settings.local.json"
        sed "s/{{REPO_NAME}}/$repo_name/g" "$template" > "$settings"
        chmod 600 "$settings"
        echo -e "${GREEN}✓ Created settings.local.json${NC}"
    else
        echo -e "${YELLOW}Warning: Template not found: $template${NC}"
    fi

    echo ""
    echo -e "${GREEN}✓ Repository initialized${NC}"
    echo ""
    echo "Next steps:"
    echo "1. cd $repo_path"
    echo "2. Run 'claude' and accept workspace trust when prompted"
    echo "3. Start the session: claude-session start $repo"
}

# Command: add
cmd_add() {
    echo -e "${BLUE}=== Add New Claude Session ===${NC}"
    echo ""

    read -p "Repository name (e.g., my-project): " repo_name
    if [ -z "$repo_name" ]; then
        echo -e "${RED}Error: Repository name required${NC}"
        exit 1
    fi

    local config_file="$CONFIG_DIR/${repo_name}.yaml"
    if [ -f "$config_file" ]; then
        echo -e "${RED}Error: Configuration already exists: $config_file${NC}"
        exit 1
    fi

    read -p "Repository path (e.g., /root/my-project): " repo_path
    if [ ! -d "$repo_path" ]; then
        echo -e "${YELLOW}Warning: Directory does not exist: $repo_path${NC}"
        read -p "Continue anyway? (y/n): " continue
        if [ "$continue" != "y" ]; then
            exit 1
        fi
    fi

    read -p "Tmux session name (e.g., claude-myproject): " tmux_session
    read -p "Discord channel ID: " channel_id

    echo ""
    echo "Using shared Discord bot token from environment"
    echo "Using shared webhook URL from environment"
    echo ""

    cat > "$config_file" <<EOF
# Claude Code Session Configuration
repo_name: $repo_name
repo_path: $repo_path
tmux_session: $tmux_session
discord_channel_id: $channel_id
discord_bot_token_env: DISCORD_BOT_TOKEN
webhook_url_env: DISCORD_WEBHOOK_URL
enabled: true
EOF

    echo -e "${GREEN}✓ Configuration created: $config_file${NC}"
    echo ""
    echo "Next steps:"
    echo "1. Create Discord channel for this repo (if not already done)"
    echo "2. Initialize repo: claude-session init-repo $repo_name"
    echo "3. Start session: claude-session start $repo_name"
}

# Main command dispatcher
case "${1:-}" in
    list)
        cmd_list
        ;;
    status)
        cmd_status
        ;;
    start)
        cmd_start "$2"
        ;;
    stop)
        cmd_stop "$2"
        ;;
    restart)
        cmd_restart "$2"
        ;;
    logs)
        cmd_logs "$2"
        ;;
    init-repo)
        cmd_init_repo "$2"
        ;;
    add)
        cmd_add
        ;;
    *)
        echo "Claude Session Manager"
        echo ""
        echo "Usage: claude-session <command> [arguments]"
        echo ""
        echo "Commands:"
        echo "  list                 Show all configured sessions with status"
        echo "  status               Quick status overview of all sessions"
        echo "  start <repo>         Start bot and tmux session for a repo"
        echo "  stop <repo>          Stop bot instance for a repo"
        echo "  restart <repo>       Restart bot instance"
        echo "  logs <repo>          Tail logs for a repo"
        echo "  init-repo <repo>     Initialize Claude Code settings in repo"
        echo "  add                  Interactive wizard to add new repo"
        echo ""
        echo "Examples:"
        echo "  claude-session list"
        echo "  claude-session start config-files"
        echo "  claude-session logs website"
        exit 1
        ;;
esac
