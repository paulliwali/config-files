# --- PATH ---
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.opencode/bin:$PATH"

# --- Oh My Zsh ---
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""  # Using starship

plugins=(
    git
    zsh-completions
    zsh-autosuggestions
    zsh-syntax-highlighting
)

source "$ZSH/oh-my-zsh.sh"

# --- Secrets (not tracked in git) ---
[ -f ~/.secrets ] && source ~/.secrets

# --- Aliases ---
alias zshconfig="vim ~/.zshrc"
alias zshsource="source ~/.zshrc"

# git
alias gst="git status"
alias glr="git lr"
alias gaa="git add -A"
alias gau="git add -u"
alias gd="git diff"
alias gdc="git diff --cached"

# modern CLI replacements (only if installed)
command -v eza   &>/dev/null && alias ls="eza --icons"
command -v eza   &>/dev/null && alias ll="eza -la --icons --git"
command -v eza   &>/dev/null && alias la="eza -a --icons"
command -v bat   &>/dev/null && alias cat="bat"
command -v fd    &>/dev/null && alias find="fd"

# --- Tool inits (must be last) ---
command -v zoxide  &>/dev/null && eval "$(zoxide init zsh)"
eval "$(starship init zsh)"
